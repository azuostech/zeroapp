{
  "framework": "nextjs",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/monthly-email",
      "schedule": "0 8 1 * *"
    },
    {
      "path": "/api/cron/reconnect-email",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/shamar-index",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/irc-delivery",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/patrimony-monthly",
      "schedule": "0 6 1 * *"
    },
    {
      "path": "/api/cron/patrimony-reminder",
      "schedule": "0 12 5 * *"
    },
    {
      "path": "/api/cron/market-indices",
      "schedule": "0 22 * * 1-5"
    },
    {
      "path": "/api/cron/market-b3",
      "schedule": "15 22 * * 1-5"
    },
    {
      "path": "/api/cron/market-tesouro",
      "schedule": "30 22 * * 1-5"
    },
    {
      "path": "/api/cron/market-cvm",
      "schedule": "0 11 * * 1-6"
    },
    {
      "path": "/api/cron/investments-revalue",
      "schedule": "0 23 * * *"
    }
  ]
}
